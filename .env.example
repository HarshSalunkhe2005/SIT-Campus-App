# Copy to `.env` (git-ignored) in the repo root and fill in real values, or set these as environment variables.
# NEVER commit the real file.

# PostgreSQL (e.g. a Supabase connection string)
DB_URL=jdbc:postgresql://HOST:6543/postgres?prepareThreshold=0
DB_USERNAME=
DB_PASSWORD=

# Email used to send OTP and resolution emails (for Gmail use an app password)
MAIL_USERNAME=
MAIL_PASSWORD=

# Secret used to sign login tokens: at least 32 random characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# --- optional ---
# Origins allowed to call the API from a browser (comma separated)
#CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Where uploaded photos are stored
#UPLOAD_DIR=uploads
# Hibernate schema handling: update (default), validate, none
#DDL_AUTO=update
# Token lifetime in milliseconds (default 24 h)
#JWT_EXPIRY_MS=86400000

# First-run setup: creates the admin if it does not exist, and the default departments if BOOTSTRAP_DEPT_PASSWORD is set.
# Existing accounts are never modified. Remove these once the accounts exist.
#BOOTSTRAP_ADMIN_EMAIL=admin@sitpune.edu.in
#BOOTSTRAP_ADMIN_PASSWORD=
#BOOTSTRAP_DEPT_PASSWORD=
